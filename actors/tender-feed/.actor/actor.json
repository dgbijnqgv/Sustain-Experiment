{
    "actorSpecification": 1,
    "name": "public-tender-feed",
    "title": "Public Tender Feed: EU TED + UK + SAM.gov (new & changed only)",
    "description": "One normalized feed of government tenders from TED (EU), UK Find a Tender, UK Contracts Finder and SAM.gov. Filter by keyword, CPV, NAICS, country and value. Scheduled runs return only new or changed notices.",
    "version": "0.1",
    "buildTag": "latest",
    "input": "./input_schema.json",
    "dockerfile": "./Dockerfile",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "views": {
                "overview": {
                    "title": "Tenders",
                    "transformation": { "fields": ["changeType", "source", "title", "buyerName", "country", "deadlineAt", "value", "cpv", "naics", "url"] },
                    "display": {
                        "component": "table",
                        "properties": {
                            "changeType": { "label": "Change" },
                            "source": { "label": "Source" },
                            "title": { "label": "Title" },
                            "buyerName": { "label": "Buyer" },
                            "country": { "label": "Country" },
                            "deadlineAt": { "label": "Deadline", "format": "date" },
                            "value": { "label": "Value", "format": "object" },
                            "cpv": { "label": "CPV", "format": "array" },
                            "naics": { "label": "NAICS", "format": "array" },
                            "url": { "label": "Link", "format": "link" }
                        }
                    }
                }
            }
        }
    }
}
